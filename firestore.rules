rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'sfimportsdf@gmail.com' ||
        request.auth.token.email == 'raquelrafen@gmail.com' ||
        request.auth.token.email == 'rsafen@gmail.com' ||
        request.auth.token.email == 'safffnb@gmail.com' ||
        request.auth.token.email == 'saffnb@gmail.com' ||
        request.auth.token.email == 'safnb@gmail.com'
      );
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$'); }

    // Validation definitions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 200))
        && (!data.keys().hasAny(['displayName']) || (data.displayName == null || (data.displayName is string && data.displayName.size() <= 200)))
        && (!data.keys().hasAny(['isPro']) || data.isPro is bool);
    }

    function isValidUserUpdate(data) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.uid == existing().uid
        && data.createdAt == existing().createdAt
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 200))
        && (!data.keys().hasAny(['displayName']) || (data.displayName == null || (data.displayName is string && data.displayName.size() <= 200)))
        && (!data.keys().hasAny(['isPro']) || data.isPro is bool);
    }

    function isValidProtocol(data) {
      return data.keys().hasAll(['userId', 'protocolName', 'createdAt'])
        && data.userId == request.auth.uid
        && data.protocolName is string && data.protocolName.size() <= 200
        && data.createdAt == request.time
        && (!data.keys().hasAny(['data']) || data.data is map);
    }

    // Collections
    
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == request.auth.uid
                    && (incoming().keys().hasAny(['isPro']) ? (incoming().isPro == false || isAdmin()) : true);

      allow update: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidId(userId)
                    && isValidUserUpdate(incoming())
                    && (
                      isAdmin() ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'displayName', 'email'])
                    );
    }

    match /pro_grants/{emailId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.token.email != null && request.auth.token.email.lower() == emailId.lower());
      allow write: if isAdmin() && isValidId(emailId);
    }

    match /protocols/{protocolId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn()
                    && isValidId(protocolId)
                    && isValidProtocol(incoming());
                    
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false; // currently protocols are immutable
    }

  }
}
