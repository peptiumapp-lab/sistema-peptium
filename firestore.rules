rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entidade: User ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'isPro']) 
          && data.uid == request.auth.uid
          && data.email is string && data.email.size() <= 200
          && data.isPro is bool
          && (data.get('displayName', '') is string)
          && (data.get('photoURL', '') is string);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Only allow updating profile info, not isPro directly (unless via admin or specific logic, but for now we keep it simple)
        // In a real app, isPro would be updated via a cloud function reacting to a payment
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      );
    }

    // --- Entidade: SavedPeptide ---
    function isValidSavedPeptide(data) {
      return data.peptideId is string && data.peptideId.size() <= 128
          && data.userId == request.auth.uid;
    }

    match /users/{userId}/savedPeptides/{peptideId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSavedPeptide(incoming()) && isValidId(peptideId);
      allow delete: if isOwner(userId);
    }
  }
}
