rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'isPro', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.uid is string &&
             data.email is string &&
             data.isPro is bool &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // 2. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
                      isValidUser(request.resource.data) && 
                      request.resource.data.isPro == false && // Can't self-grant Pro
                      request.resource.data.createdAt == request.time;
      
      allow update: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.updatedAt == request.time &&
                      (
                        // Profile update (no Pro change)
                        (request.resource.data.isPro == resource.data.isPro && 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
                        // Pro status can ONLY be updated by a cloud function or admin in a real app,
                        // for this demo we might keep it client-side but restricted. 
                        // In a real Prime app, this would be server-authoritative via Stripe webhook.
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPro', 'updatedAt']))
                      );
    }
  }
}
