{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account details and membership status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "displayName": { "type": "string", "description": "User display name" },
        "isPro": { "type": "boolean", "description": "Subscription status" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "isPro"]
    },
    "Protocol": {
      "title": "Saved Protocol",
      "description": "User's saved generated protocol",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User who owns this protocol" },
        "protocolName": { "type": "string" },
        "data": { "type": "object", "description": "Raw JSON object with protocol data" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "protocolName", "data", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "protocols/{protocolId}": {
      "schema": "Protocol",
      "description": "Saved AI generated protocols"
    }
  }
}
