{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "isPro": { "type": "boolean" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "ProGrant": {
      "title": "ProGrant",
      "description": "Document tracking manual pro grants by admins",
      "type": "object",
      "properties": {
        "grantedBy": { "type": "string" },
        "grantedAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "email": { "type": "string" }
      },
      "required": ["grantedBy", "grantedAt", "expiresAt", "email"]
    },
    "Protocol": {
      "title": "Protocol",
      "description": "User generated protocols by AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "protocolName": { "type": "string" },
        "data": { "type": "object" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["userId", "protocolName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/pro_grants/{emailId}": {
      "schema": { "$ref": "#/entities/ProGrant" },
      "description": "Pro grants for users by email. Accessible by admins only, and readable by the user"
    },
    "/protocols/{protocolId}": {
      "schema": { "$ref": "#/entities/Protocol" },
      "description": "AI generated protocols stored by users"
    }
  }
}
